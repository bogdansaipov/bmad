// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  HANDYMAN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  password_hash  String
  role           UserRole
  account_status AccountStatus    @default(ACTIVE)
  created_at     DateTime         @default(now())

  customerProfile         CustomerProfile?
  handymanProfile         HandymanProfile?
  customerRequests        ServiceRequest[]          @relation("CustomerRequests")
  handymanJobs            ServiceRequest[]          @relation("HandymanAssignments")
  uploadedImages          RequestImage[]            @relation("UploadedImages")
  assignmentRecords       RequestAssignment[]       @relation("HandymanAssignmentRecords")
  statusHistoryEntries    RequestStatusHistory[]    @relation("StatusHistoryEntries")
  handymanLocationUpdates HandymanLocationUpdate[]
  ratingsGiven            RequestRating[]           @relation("CustomerRatings")
  ratingsReceived         RequestRating[]           @relation("HandymanRatingsReceived")

  @@map("users")
}

model CustomerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id])

  @@map("customer_profiles")
}

model HandymanProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  displayName         String   @map("display_name")
  availabilityStatus  String   @default("offline") @map("availability_status")
  serviceRadiusKm     Float?   @map("service_radius_km")
  baseLocationLat     Float?   @map("base_location_lat")
  baseLocationLng     Float?   @map("base_location_lng")
  averageRatingCache  Float?   @map("average_rating_cache")
  ratingsCountCache   Int?     @map("ratings_count_cache")
  createdAt           DateTime @default(now()) @map("created_at")

  user                User                          @relation(fields: [userId], references: [id])
  categoryPreferences HandymanCategoryPreference[]
  jobOffers           JobOfferVisibility[]

  @@map("handyman_profiles")
}

model HandymanCategoryPreference {
  id                String   @id @default(uuid())
  handymanProfileId String   @map("handyman_profile_id")
  categoryId        String   @map("category_id")
  createdAt         DateTime @default(now()) @map("created_at")

  handymanProfile HandymanProfile @relation(fields: [handymanProfileId], references: [id], onDelete: Cascade)
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([handymanProfileId, categoryId])
  @@index([handymanProfileId])
  @@index([categoryId])
  @@map("handyman_category_preferences")
}

enum RequestStatus {
  PENDING
  ASSIGNED
  ON_THE_WAY
  ARRIVED
  WORKING
  COMPLETE
  REJECTED
}

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  requests             ServiceRequest[]
  handymanPreferences  HandymanCategoryPreference[]

  @@map("service_categories")
}

model ServiceRequest {
  id                         String         @id @default(uuid())
  customerId                 String         @map("customer_id")
  categoryId                 String         @map("category_id")
  title                      String
  description                String?
  status                     RequestStatus  @default(PENDING)
  locationLat                Float?         @map("location_lat")
  locationLng                Float?         @map("location_lng")
  estimatedTotal             Decimal?       @map("estimated_total") @db.Decimal(10, 2)
  pricingExplanationSnapshot Json?          @map("pricing_explanation_snapshot")
  assignedHandymanId         String?        @map("assigned_handyman_id")
  completedAt                DateTime?      @map("completed_at")
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")

  customer         User             @relation("CustomerRequests", fields: [customerId], references: [id])
  category         ServiceCategory  @relation(fields: [categoryId], references: [id])
  assignedHandyman User?            @relation("HandymanAssignments", fields: [assignedHandymanId], references: [id])
  images           RequestImage[]
  jobOffers        JobOfferVisibility[]
  assignment       RequestAssignment?
  statusHistory    RequestStatusHistory[]
  locationUpdates  HandymanLocationUpdate[]
  rating           RequestRating?

  @@index([customerId, createdAt])
  @@index([status])
  @@index([assignedHandymanId])
  @@index([categoryId])
  @@map("service_requests")
}

model RequestAssignment {
  id               String   @id @default(uuid())
  requestId        String   @unique @map("request_id")
  handymanUserId   String   @map("handyman_user_id")
  acceptedAt       DateTime @default(now()) @map("accepted_at")
  assignmentStatus String   @default("active") @map("assignment_status")

  request  ServiceRequest @relation(fields: [requestId], references: [id])
  handyman User           @relation("HandymanAssignmentRecords", fields: [handymanUserId], references: [id])

  @@map("request_assignments")
}

model RequestStatusHistory {
  id        String        @id @default(uuid())
  requestId String        @map("request_id")
  status    RequestStatus
  actorType String        @map("actor_type")
  actorId   String?       @map("actor_id")
  createdAt DateTime      @default(now()) @map("created_at")
  metadata  Json?

  request ServiceRequest @relation(fields: [requestId], references: [id])
  actor   User?          @relation("StatusHistoryEntries", fields: [actorId], references: [id])

  @@index([requestId, createdAt])
  @@map("request_status_history")
}

model RequestImage {
  id         String          @id @default(uuid())
  requestId  String?         @map("request_id")
  uploaderId String          @map("uploader_id")
  filePath   String          @map("file_path")
  mimeType   String          @map("mime_type")
  sizeBytes  Int             @map("size_bytes")
  createdAt  DateTime        @default(now()) @map("created_at")

  request    ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  uploader   User            @relation("UploadedImages", fields: [uploaderId], references: [id])

  @@index([requestId])
  @@index([uploaderId])
  @@map("request_images")
}

model JobOfferVisibility {
  id                String    @id @default(uuid())
  requestId         String    @map("request_id")
  handymanProfileId String    @map("handyman_profile_id")
  offerStatus       String    @default("pending") @map("offer_status")
  offeredAt         DateTime  @default(now()) @map("offered_at")
  respondedAt       DateTime? @map("responded_at")

  request         ServiceRequest  @relation(fields: [requestId], references: [id])
  handymanProfile HandymanProfile @relation(fields: [handymanProfileId], references: [id])

  @@unique([requestId, handymanProfileId])
  @@index([requestId])
  @@index([handymanProfileId])
  @@map("job_offer_visibilities")
}

model HandymanLocationUpdate {
  id         String   @id @default(cuid())
  requestId  String   @map("request_id")
  handymanId String   @map("handyman_id")
  lat        Float
  lng        Float
  recordedAt DateTime @default(now()) @map("recorded_at")

  request  ServiceRequest @relation(fields: [requestId], references: [id])
  handyman User           @relation(fields: [handymanId], references: [id])

  @@index([requestId, recordedAt])
  @@map("handyman_location_updates")
}

model RequestRating {
  id            String   @id @default(uuid())
  requestId     String   @unique @map("request_id")
  customerId    String   @map("customer_id")
  handymanId    String   @map("handyman_id")
  stars         Int
  shortFeedback String?  @map("short_feedback")
  createdAt     DateTime @default(now()) @map("created_at")

  request  ServiceRequest @relation(fields: [requestId], references: [id])
  customer User           @relation("CustomerRatings", fields: [customerId], references: [id])
  handyman User           @relation("HandymanRatingsReceived", fields: [handymanId], references: [id])

  @@map("request_ratings")
}
