// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  HANDYMAN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  password_hash  String
  role           UserRole
  account_status AccountStatus    @default(ACTIVE)
  created_at     DateTime         @default(now())

  customerProfile   CustomerProfile?
  handymanProfile   HandymanProfile?
  customerRequests  ServiceRequest[] @relation("CustomerRequests")
  handymanJobs      ServiceRequest[] @relation("HandymanAssignments")
  uploadedImages    RequestImage[]   @relation("UploadedImages")

  @@map("users")
}

model CustomerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id])

  @@map("customer_profiles")
}

model HandymanProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  displayName         String   @map("display_name")
  availabilityStatus  String   @default("offline") @map("availability_status")
  serviceRadiusKm     Float?   @map("service_radius_km")
  averageRatingCache  Float?   @map("average_rating_cache")
  ratingsCountCache   Int?     @map("ratings_count_cache")
  createdAt           DateTime @default(now()) @map("created_at")

  user                User     @relation(fields: [userId], references: [id])

  @@map("handyman_profiles")
}

enum RequestStatus {
  PENDING
  ASSIGNED
  ON_THE_WAY
  ARRIVED
  WORKING
  COMPLETE
  REJECTED
}

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  requests    ServiceRequest[]

  @@map("service_categories")
}

model ServiceRequest {
  id                         String         @id @default(uuid())
  customerId                 String         @map("customer_id")
  categoryId                 String         @map("category_id")
  title                      String
  description                String?
  status                     RequestStatus  @default(PENDING)
  locationLat                Float?         @map("location_lat")
  locationLng                Float?         @map("location_lng")
  estimatedTotal             Decimal?       @map("estimated_total") @db.Decimal(10, 2)
  pricingExplanationSnapshot Json?          @map("pricing_explanation_snapshot")
  assignedHandymanId         String?        @map("assigned_handyman_id")
  completedAt                DateTime?      @map("completed_at")
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")

  customer         User             @relation("CustomerRequests", fields: [customerId], references: [id])
  category         ServiceCategory  @relation(fields: [categoryId], references: [id])
  assignedHandyman User?            @relation("HandymanAssignments", fields: [assignedHandymanId], references: [id])
  images           RequestImage[]

  @@index([customerId, createdAt])
  @@index([status])
  @@index([assignedHandymanId])
  @@index([categoryId])
  @@map("service_requests")
}

model RequestImage {
  id         String          @id @default(uuid())
  requestId  String?         @map("request_id")
  uploaderId String          @map("uploader_id")
  filePath   String          @map("file_path")
  mimeType   String          @map("mime_type")
  sizeBytes  Int             @map("size_bytes")
  createdAt  DateTime        @default(now()) @map("created_at")

  request    ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  uploader   User            @relation("UploadedImages", fields: [uploaderId], references: [id])

  @@index([requestId])
  @@index([uploaderId])
  @@map("request_images")
}

