HANDRIX_ENV=production
HANDRIX_API_PORT=3000
HANDRIX_API_CORS_ORIGIN=https://app.handrix.example
HANDRIX_TRUST_PROXY=true
HANDRIX_RATE_LIMIT_DEFAULT_LIMIT=120
HANDRIX_RATE_LIMIT_DEFAULT_TTL_MS=60000
HANDRIX_DATABASE_URL=postgresql://handrix:${HANDRIX_DB_PASSWORD}@prod-db.handrix.internal:5432/handrix?schema=public

# Production signing and tracking secrets
HANDRIX_INTERNAL_AUTH_SECRET=replace-with-production-internal-auth-secret
HANDRIX_INTERNAL_AUTH_ISSUER=handrix-api
HANDRIX_INTERNAL_AUTH_TTL_MINUTES=480
HANDRIX_REQUEST_TOKEN_SECRET=replace-with-production-request-token-secret

# Production staff credentials or seeded bootstrap values
HANDRIX_OPS_EMAIL=ops@handrix.example
HANDRIX_OPS_PASSWORD=replace-with-production-ops-password
HANDRIX_OPS_DISPLAY_NAME=Operations Coordinator
HANDRIX_SUPPORT_EMAIL=support@handrix.example
HANDRIX_SUPPORT_PASSWORD=replace-with-production-support-password
HANDRIX_SUPPORT_DISPLAY_NAME=Support Coordinator
