HANDRIX_ENV=development
HANDRIX_API_PORT=3000
HANDRIX_API_CORS_ORIGIN=http://localhost:5173
HANDRIX_TRUST_PROXY=false
HANDRIX_RATE_LIMIT_DEFAULT_LIMIT=120
HANDRIX_RATE_LIMIT_DEFAULT_TTL_MS=60000
HANDRIX_DATABASE_URL=postgresql://handrix:handrix@localhost:5432/handrix?schema=public

# Internal auth signing secret (required in production)
HANDRIX_INTERNAL_AUTH_SECRET=handrix-local-internal-auth-secret
HANDRIX_INTERNAL_AUTH_ISSUER=handrix-api
HANDRIX_INTERNAL_AUTH_TTL_MINUTES=480
HANDRIX_REQUEST_TOKEN_SECRET=handrix-local-tracking-secret

# Operations staff credentials (env-backed seed user for MVP)
HANDRIX_OPS_EMAIL=ops@handrix.local
HANDRIX_OPS_PASSWORD=ops-demo-pass
HANDRIX_OPS_DISPLAY_NAME=Operations Coordinator

# Support staff credentials (env-backed seed user for MVP)
HANDRIX_SUPPORT_EMAIL=support@handrix.local
HANDRIX_SUPPORT_PASSWORD=support-demo-pass
HANDRIX_SUPPORT_DISPLAY_NAME=Support Coordinator
