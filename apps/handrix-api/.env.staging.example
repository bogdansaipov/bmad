HANDRIX_ENV=staging
HANDRIX_API_PORT=3000
HANDRIX_API_CORS_ORIGIN=https://web.staging.handrix.example
HANDRIX_TRUST_PROXY=true
HANDRIX_RATE_LIMIT_DEFAULT_LIMIT=120
HANDRIX_RATE_LIMIT_DEFAULT_TTL_MS=60000
HANDRIX_DATABASE_URL=postgresql://handrix:${HANDRIX_DB_PASSWORD}@staging-db.handrix.internal:5432/handrix?schema=public

# Staging signing and tracking secrets
HANDRIX_INTERNAL_AUTH_SECRET=replace-with-staging-internal-auth-secret
HANDRIX_INTERNAL_AUTH_ISSUER=handrix-api-staging
HANDRIX_INTERNAL_AUTH_TTL_MINUTES=480
HANDRIX_REQUEST_TOKEN_SECRET=replace-with-staging-request-token-secret

# Staging staff credentials or seeded bootstrap values
HANDRIX_OPS_EMAIL=ops@staging.handrix.example
HANDRIX_OPS_PASSWORD=replace-with-staging-ops-password
HANDRIX_OPS_DISPLAY_NAME=Operations Coordinator
HANDRIX_SUPPORT_EMAIL=support@staging.handrix.example
HANDRIX_SUPPORT_PASSWORD=replace-with-staging-support-password
HANDRIX_SUPPORT_DISPLAY_NAME=Support Coordinator
